rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check probe
    match /test/{docId} {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Patients collection
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().caregiverUid == request.auth.uid;
      allow update: if isSignedIn() && (incoming().caregiverUid == request.auth.uid || existing().caregiverUid == request.auth.uid);
      allow delete: if isSignedIn() && existing().caregiverUid == request.auth.uid;
    }

    // Medicines collection
    match /medicines/{medicineId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().caregiverUid == request.auth.uid;
      allow update: if isSignedIn() && (incoming().caregiverUid == request.auth.uid || existing().caregiverUid == request.auth.uid);
      allow delete: if isSignedIn() && existing().caregiverUid == request.auth.uid;
    }

    // Scheduled doses
    match /scheduled_doses/{doseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Chat messages
    match /chat_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
